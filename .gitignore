# NetBeans specific (any project)
nbproject/private/
build/
dist/

# Compiled class files
*.class

# Log files
*.log

# Package files
*.jar
*.war
*.ear

# IDE files
*.iml
*.ipr
*.iws
.idea/

# OS generated files
.DS_Store
Thumbs.db

# Otros ficheros y dirs to ignore
.*
.*/
# ignore all hidden files in all tree
**/.*
# ignore all hidden folders in all tree
**/.*/
# do not ignore this hidden file
!/.gitignore

/.cache/
/.config/

*.graphml
*.txt
*.odt
*.odg
*.model
# Ignore all .zip files
*.zip


# AI assistant documentation
CLAUDE.md
GEMINI.md

# Build scripts (all .sh in base folder)
/*.sh
count_lines.sh
generate_javadocs.sh
release.sh

# ---------------------------------------------------------------
# 1. Open the door to the folder and its subdirectories
!/todeploy/
!/todeploy/**/

# 2. Open the door for all files EXCEPT hidden ones
!/todeploy/**/*

# 3. RE-IGNORE hidden files and folders inside todeploy
/todeploy/**/.*
/todeploy/**/./

# 4. Specifically UN-IGNORE package files (to fix the .jar issue)
!/todeploy/**/*.jar
!/todeploy/**/*.war

# 5. The specific exclusions (Blacklist)
/todeploy/etc/glue-settings.json
/todeploy/log/
/todeploy/tmp/
