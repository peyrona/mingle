/0.PhD/
/balata/
/build/
/docs/
/javadocs/
/website/
/menu/nbproject/private/
/gumjetty/nbproject/private/
/gum/nbproject/private/

# Twig (ESP-IDF native runtime rewrite)
# NOTE: build/ dirs (twig/build, tools/compat_checker/build, per-component
# test/build, etc.) are already covered by the generic "build/" rule above.
/twig/sdkconfig
/twig/sdkconfig.old
/twig/doc/api-docs/
# GENERATED by tools/build_model.sh from a .model file
/twig/main/model_data.hpp
# GENERATED by tools/build_model.sh (per-model driver selection)
/twig/main/driver_selection.defaults
